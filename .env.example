# JD Creator Environment Configuration
# Copy this to .env and fill in your values

# AWS Configuration
JD_AWS_REGION=us-east-1
JD_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
JD_AWS_PROFILE=

# Model Parameters
JD_BEDROCK_TEMPERATURE=0.2
JD_BEDROCK_MAX_TOKENS=4096
JD_BEDROCK_REQUEST_TIMEOUT_SECONDS=60.0
JD_BEDROCK_MAX_RETRIES=3

# Application Tuning
JD_OVERALL_DEADLINE_SECONDS=120.0
JD_MAX_CONCURRENT_GENERATIONS=10
JD_MAX_REQUEST_BODY_BYTES=100000
JD_PER_IP_RATE_LIMIT_PER_MINUTE=30

# Logging
JD_LOG_LEVEL=INFO

# Next.js frontend backend connection
# In development, the frontend defaults to http://127.0.0.1:8000 when unset.
# Set this for a deployed frontend or a backend running at a different URL.
JD_CREATOR_API_URL=http://127.0.0.1:8000
# Set to true only to use the frontend's built-in sample response instead of the backend.
JD_CREATOR_USE_MOCK=false
